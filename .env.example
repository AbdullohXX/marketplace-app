# Local development only. Supply your own database credentials.
DATABASE_URL=postgresql://marketplace:CHANGE_ME@127.0.0.1:5432/marketplace
# Used by Compose; must match the password in DATABASE_URL.
DATABASE_PASSWORD=CHANGE_ME
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=marketplace
PORT=3000
# Optional: enables protected product management routes. Generate a long random value.
ADMIN_TOKEN=
# Set only if deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=0
