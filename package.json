{
  "name": "savdo-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup.js",
    "db:benchmark": "node --env-file-if-exists=.env scripts/benchmark.js",
    "test": "node test/unit.test.js",
    "test:integration": "node --env-file-if-exists=.env test/integration.test.js"
  },
  "dependencies": {
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0",
    "mongodb": "6.20.0",
    "pg": "8.16.3"
  }
}
